# Личные исходники владельца (фото, резюме, CV) — не публикуются в репозитории.
# В репозиторий попадает только инструкция Data/README.md
Data/*
!Data/README.md

# Секреты
.env
.env.*
!.env.example

# Зависимости и сборка (пригодятся после скаффолдинга Astro)
node_modules/
dist/
.astro/

# Системные файлы
.DS_Store
Thumbs.db
