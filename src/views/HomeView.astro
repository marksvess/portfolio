---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Avatar from '@/components/Avatar.astro';
import AppCard from '@/components/AppCard.astro';
import PostCard from '@/components/PostCard.astro';
import Button from '@/components/ui/Button.astro';
import { t, url, type Lang } from '@/lib/i18n';
import { getApps, getPosts, getProfile } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const p = await getProfile(lang);
const apps = await getApps(lang);
const featured = (apps.filter((a) => a.data.featured).length ? apps.filter((a) => a.data.featured) : apps).slice(0, 4);
const posts = (await getPosts(lang)).slice(0, 3);
---

<BaseLayout lang={lang}>
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-primary">{p.title}{p.location && ` · ${p.location}`}</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{p.name}</h1>
      <p class="mt-4 text-lg text-muted-foreground">{p.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={url('apps/', lang)} size="lg">{s.hero.viewApps}</Button>
        <Button href={url('contact/', lang)} size="lg" variant="outline">{s.hero.contact}</Button>
      </div>
    </div>
    <Avatar name={p.name} photo={p.photo} class="h-32 w-32 shrink-0 sm:h-44 sm:w-44" />
  </section>

  {
    p.highlights.length > 0 && (
      <section class="mt-16">
        <h2 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">{s.home.highlights}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {p.highlights.map((h) => (
            <li class="rounded-xl border p-4">{h}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    p.skills.length > 0 && (
      <section class="mt-16">
        <h2 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">{s.home.skills}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {p.skills.map((sk) => (
            <div class="rounded-xl border p-4">
              <h3 class="font-semibold">{sk.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{sk.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold">{s.home.featured}</h2>
      <a href={url('apps/', lang)} class="text-sm text-primary hover:underline">{s.home.allApps} →</a>
    </div>
    {
      featured.length ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {featured.map((app) => (
            <AppCard app={app} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">{s.apps.empty}</p>
      )
    }
  </section>

  {
    posts.length > 0 && (
      <section class="mt-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold">{s.home.latestPosts}</h2>
          <a href={url('blog/', lang)} class="text-sm text-primary hover:underline">
            {s.home.allPosts} →
          </a>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
