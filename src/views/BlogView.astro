---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { t, type Lang } from '@/lib/i18n';
import { getPosts } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={s.blog.title} description={s.blog.description}>
  <h1 class="text-4xl font-bold">{s.blog.title}</h1>
  <p class="mt-3 max-w-2xl text-muted-foreground">{s.blog.description}</p>
  {
    posts.length ? (
      <div class="mt-8 grid gap-4">
        {posts.map((post) => (
          <PostCard post={post} lang={lang} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-muted-foreground">{s.blog.empty}</p>
    )
  }
</BaseLayout>
