---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatDate, t, url, type Lang } from '@/lib/i18n';
import type { PostEntry } from '@/lib/content';

interface Props {
  post: PostEntry;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t(lang);
const { Content } = await render(post);
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-2xl">
    <a href={url('blog/', lang)} class="text-sm text-muted-foreground hover:text-foreground">← {s.blog.back}</a>
    <header class="mt-6">
      <time class="text-sm text-muted-foreground" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      <h1 class="mt-2 text-4xl font-bold">{post.data.title}</h1>
      <div class="mt-3 flex flex-wrap gap-1.5">{post.data.tags.map((tag) => <Badge>{tag}</Badge>)}</div>
    </header>
    <div class="prose mt-10 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
