---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { t, type Lang } from '@/lib/i18n';
import { getProfile } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const p = await getProfile(lang);

// Web3Forms: публичный ключ формы, не секрет. Задаётся переменной репозитория PUBLIC_WEB3FORMS_KEY.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const direct = [
  p.contacts.email && { label: p.contacts.email, href: `mailto:${p.contacts.email}` },
  p.contacts.telegram && { label: 'Telegram', href: p.contacts.telegram },
  p.contacts.linkedin && { label: 'LinkedIn', href: p.contacts.linkedin },
  p.contacts.github && { label: 'GitHub', href: p.contacts.github },
].filter(Boolean) as { label: string; href: string }[];

const field = 'mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-base';
---

<BaseLayout lang={lang} title={s.contact.title} description={s.contact.description}>
  <div class="mx-auto max-w-xl">
    <h1 class="text-4xl font-bold">{s.contact.title}</h1>
    <p class="mt-3 text-muted-foreground">{s.contact.description}</p>

    {
      formKey ? (
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-4">
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value={`Portfolio: new message (${lang})`} />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
          <label class="block">
            <span class="text-sm font-medium">{s.contact.name}</span>
            <input name="name" required autocomplete="name" class={field} />
          </label>
          <label class="block">
            <span class="text-sm font-medium">{s.contact.email}</span>
            <input name="email" type="email" required autocomplete="email" class={field} />
          </label>
          <label class="block">
            <span class="text-sm font-medium">{s.contact.message}</span>
            <textarea name="message" required rows="6" class={field} />
          </label>
          <Button type="submit" size="lg" data-sending={s.contact.sending}>
            {s.contact.send}
          </Button>
          <p id="form-status" class="text-sm" role="status" data-success={s.contact.success} data-error={s.contact.error} />
        </form>
      ) : (
        <p class="mt-8 rounded-xl border p-4 text-sm text-muted-foreground">{s.contact.formDisabled}</p>
      )
    }

    {
      direct.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-semibold text-muted-foreground uppercase">{s.contact.direct}</h2>
          <ul class="mt-3 flex flex-wrap gap-3">
            {direct.map((d) => (
              <li>
                <Button href={d.href} variant="outline" external={!d.href.startsWith('mailto:')}>
                  {d.label}
                </Button>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const label = btn?.textContent ?? '';
    if (btn) {
      btn.disabled = true;
      btn.textContent = btn.dataset.sending ?? '…';
    }
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      if (status) status.textContent = status.dataset.success ?? '';
    } catch {
      if (status) status.textContent = status.dataset.error ?? '';
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = label;
      }
    }
  });
</script>
