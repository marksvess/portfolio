---
import { t, type Lang } from '@/lib/i18n';
import { getProfile } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const p = await getProfile(lang);
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: p.contacts.linkedin },
  { label: 'Telegram', href: p.contacts.telegram },
  { label: 'GitHub', href: p.contacts.github },
].filter((x) => x.href);
---

<footer class="no-print mt-24 border-t">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-muted-foreground">
    <span>© {year} {p.name}</span>
    <div class="flex flex-wrap gap-4">
      {
        socials.map((x) => (
          <a href={x.href} target="_blank" rel="noopener me" class="hover:text-foreground">
            {x.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
