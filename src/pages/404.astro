---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { t, url } from '@/lib/i18n';

const en = t('en');
const ru = t('ru');
---

<BaseLayout lang="en" title={en.notFound.title} noAlternates>
  <div class="py-16 text-center">
    <p class="text-6xl font-bold text-muted-foreground">404</p>
    <h1 class="mt-4 text-2xl font-bold">{en.notFound.title}</h1>
    <p class="mt-1 text-muted-foreground" lang="ru">{ru.notFound.title}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={url('', 'en')}>{en.notFound.back}</Button>
      <Button href={url('', 'ru')} variant="outline">{ru.notFound.back}</Button>
    </div>
  </div>
</BaseLayout>
